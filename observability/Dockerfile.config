FROM prom/prometheus:v3.2.1 AS prometheus
COPY prometheus/demo.yml /etc/prometheus/prometheus.yml
COPY prometheus/alerts.yml /etc/prometheus/alerts.yml

FROM grafana/tempo:2.7.2 AS tempo
COPY tempo/tempo.yaml /etc/tempo.yaml

FROM grafana/loki:3.4.2 AS loki
COPY loki/loki.yaml /etc/loki/local-config.yaml

FROM grafana/alloy:v1.8.3 AS alloy
COPY alloy/config.alloy /etc/alloy/config.alloy

FROM grafana/grafana:11.6.0 AS grafana
COPY grafana/provisioning /etc/grafana/provisioning
COPY grafana/demo-dashboards.yaml /etc/grafana/provisioning/dashboards/dashboards.yaml
COPY grafana/dashboards /etc/grafana/dashboards
